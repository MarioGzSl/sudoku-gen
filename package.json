{
  "name": "sudoku-easy-solver",
  "version": "2.0.1",
  "description": "Generate unique Sudoku puzzles, solve, analyze, explain hints and render SVG or PNG images. TypeScript-first, dependency-free core.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarioGzSl/sudoku-gen.git"
  },
  "homepage": "https://github.com/MarioGzSl/sudoku-gen#readme",
  "bugs": {
    "url": "https://github.com/MarioGzSl/sudoku-gen/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test --test-timeout=60000 --experimental-test-coverage --test-coverage-include=dist/cjs/*.js --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=85 tests/*.test.cjs",
    "test:release": "node --test scripts/check-release.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:examples": "node scripts/test-examples.cjs",
    "docs:assets": "node scripts/render-examples.cjs",
    "prepublishOnly": "npm run build && npm test && npm run test:release && npm run test:types && npm run test:package && npm run test:examples"
  },
  "keywords": [
    "sudoku",
    "puzzle",
    "generator",
    "solver",
    "typescript"
  ],
  "author": "MarioGzSl",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "@resvg/resvg-js": "^2.6.2"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./image": {
      "import": {
        "types": "./dist/esm/image.d.ts",
        "default": "./dist/esm/image.js"
      },
      "require": {
        "types": "./dist/cjs/image.d.ts",
        "default": "./dist/cjs/image.js"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/esm/async.d.ts",
        "default": "./dist/esm/async.js"
      },
      "require": {
        "types": "./dist/cjs/async.d.ts",
        "default": "./dist/cjs/async.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  }
}
